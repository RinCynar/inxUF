---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "subtitle": {{ post.subtitle | default: "" | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "category": {{ post.tags | first | default: "" | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "date_label": {{ post.date | date: "%b %d, %Y" | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncate: 480 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
